# =============================================================================
# Memorial Projetse — variáveis de ambiente
# =============================================================================
# Copie para .env.local (desenvolvimento) ou configure no painel do deploy.
# Nunca commite .env.local nem chaves service_role no repositório.
#
# Supabase Dashboard → Project Settings → API
# Projeto compartilhado (dev): jlnwoapaeiywehihilua
# Schema exposto na API: projetse
# =============================================================================

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional — apenas para scripts locais / CI (não usar no frontend):
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Cloudflare Workers (deploy): configure secrets no dashboard ou via:
#   pnpm exec wrangler secret put VITE_SUPABASE_URL
#   pnpm exec wrangler secret put VITE_SUPABASE_ANON_KEY
# Nota: variáveis VITE_* no Workers precisam estar disponíveis no build (CI) ou como vars.
